---
import MobileMenuFooter from 'virtual:starlight/components/MobileMenuFooter';
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import SidebarSublist from '@astrojs/starlight/components/SidebarSublist.astro';

const currentPath = Astro.url.pathname.replace(/\/$/, '');
const locale = Astro.locals.starlightRoute.locale;

const makeLink = (label, href) => ({
	type: 'link',
	label,
	href,
	isCurrent: currentPath === href.replace(/\/$/, ''),
	badge: undefined,
	attrs: {},
});

const makeGroup = (label, entries) => ({
	type: 'group',
	label,
	entries,
	collapsed: false,
	badge: undefined,
});

const germanSidebar = [
	makeGroup('Erste Schritte', [
		makeLink('Was ist TocaToca?', '/de/erste-schritte/was-ist-tocatoca/'),
		makeLink('Konto erstellen', '/de/erste-schritte/konto-erstellen/'),
		makeLink('Einloggen', '/de/erste-schritte/einloggen/'),
		makeLink('Abonnement aktivieren', '/de/erste-schritte/abonnement-aktivieren/'),
		makeLink('Erste Musik abspielen', '/de/erste-schritte/erste-musik-abspielen/'),
	]),
	makeGroup('Musik finden', [
		makeLink('Suche verwenden', '/de/musik-finden/suche-verwenden/'),
		makeLink('Nach Künstlern suchen', '/de/musik-finden/nach-kuenstlern-suchen/'),
		makeLink('Nach Alben/Sammlungen suchen', '/de/musik-finden/nach-alben-sammlungen-suchen/'),
		makeLink('Artist-Links verstehen', '/de/musik-finden/artist-links-verstehen/'),
		makeLink('Songlisten verwenden', '/de/musik-finden/songlisten-verwenden/'),
	]),
	makeGroup('Musik hören', [
		makeLink('Player bedienen', '/de/musik-hoeren/player-bedienen/'),
		makeLink('Warteschlange', '/de/musik-hoeren/warteschlange/'),
		makeLink('Favoriten', '/de/musik-hoeren/favoriten/'),
		makeLink('Playlists', '/de/musik-hoeren/playlists/'),
	]),
	makeGroup('Nutzung auf Geräten', [
		makeLink('Desktop Browser', '/de/nutzung-auf-geraeten/desktop-browser/'),
		makeLink('Probleme mit mobilen Browsern', '/de/nutzung-auf-geraeten/probleme-mit-mobilen-browsern/'),
	]),
	makeGroup('Konto & Zugang', [
		makeLink('Konto erstellen', '/de/erste-schritte/konto-erstellen/'),
		makeLink('Abonnementstatus', '/de/konto-zugang/abonnementstatus/'),
		makeLink('Passwort und Zugang', '/de/konto-zugang/passwort-magic-link-zugang/'),
		makeLink('Verantwortungsvolle Nutzung', '/de/konto-zugang/verantwortungsvolle-nutzung/'),
		makeLink('Ausloggen', '/de/konto-zugang/ausloggen/'),
	]),
	makeGroup('Fehlerbehebung', [
		makeLink('Kein Ton', '/de/fehlerbehebung/kein-ton/'),
		makeLink('Musik startet nicht', '/de/fehlerbehebung/musik-startet-nicht/'),
		makeLink('Login wird nicht gehalten', '/de/fehlerbehebung/login-wird-nicht-gehalten/'),
		makeLink('Seite neu laden', '/de/fehlerbehebung/seite-neu-laden/'),
		makeLink('Support kontaktieren', '/de/fehlerbehebung/support-kontaktieren/'),
	]),
	makeGroup('FAQ', [makeLink('Häufige Fragen', '/de/faq/')]),
];

const englishSidebar = [
	makeGroup('Getting Started', [
		makeLink('What is TocaToca?', '/en/getting-started/what-is-tocatoca/'),
		makeLink('Create an Account', '/en/getting-started/create-an-account/'),
		makeLink('Logging In', '/en/getting-started/logging-in/'),
		makeLink('Activate Your Subscription', '/en/getting-started/activate-your-subscription/'),
		makeLink('First Playback', '/en/getting-started/first-playback/'),
	]),
	makeGroup('Discover Music', [
		makeLink('Using Search', '/en/discover-music/using-search/'),
		makeLink('Finding Artists', '/en/discover-music/finding-artists/'),
		makeLink('Finding Albums and Collections', '/en/discover-music/finding-albums-and-collections/'),
		makeLink('Understanding Artist Links', '/en/discover-music/understanding-artist-links/'),
		makeLink('Using Recording Lists', '/en/discover-music/using-recording-lists/'),
	]),
	makeGroup('Listening', [
		makeLink('Using the Player', '/en/listening/using-the-player/'),
		makeLink('Queue', '/en/listening/queue/'),
		makeLink('Favorites', '/en/listening/favorits/'),
		makeLink('Playlists', '/en/listening/playlists-en/'),
	]),
	makeGroup('Devices', [
		makeLink('Desktop Browser', '/en/devices/desktop-browser-en/'),
		makeLink('Mobile Browser Issues', '/en/devices/mobile-browser-issues/'),
	]),
	makeGroup('Account & Access', [
		makeLink('Create an Account', '/en/getting-started/create-an-account/'),
		makeLink('Subscription Status', '/en/account-access/subscription-status/'),
		makeLink('Passwords and Account Access', '/en/account-access/passwords-account-access/'),
		makeLink('Responsible Use', '/en/account-access/responsible-use/'),
		makeLink('Logging Out', '/en/account-access/logging-out/'),
	]),
	makeGroup('Troubleshooting', [
		makeLink('No Sound', '/en/troubleshooting/no-sound/'),
		makeLink('Playback Does Not Start', '/en/troubleshooting/playback-does-not-start/'),
		makeLink('Login Is Not Remembered', '/en/troubleshooting/login-is-not-remembered/'),
		makeLink('Reloading the Page', '/en/troubleshooting/reloading-the-page/'),
		makeLink('Contact Support', '/en/troubleshooting/contact-support/'),
	]),
	makeGroup('FAQ', [makeLink('Frequently Asked Questions', '/en/faq-en/')]),
];

const frenchSidebar = [
	makeGroup('Premiers pas', [
		makeLink('Qu’est-ce que TocaToca ?', '/fr/getting-started/what-is-tocatoca/'),
		makeLink('Créer un compte', '/fr/getting-started/create-an-account/'),
		makeLink('Se connecter', '/fr/getting-started/logging-in/'),
		makeLink('Activer votre abonnement', '/fr/getting-started/activate-your-subscription/'),
		makeLink('Première écoute', '/fr/getting-started/first-playback/'),
	]),
	makeGroup('Découvrir la musique', [
		makeLink('Utiliser la recherche', '/fr/discover-music/using-search/'),
		makeLink('Trouver des artistes', '/fr/discover-music/finding-artists/'),
		makeLink('Trouver des albums et des collections', '/fr/discover-music/finding-albums-and-collections/'),
		makeLink('Comprendre les liens d’artistes', '/fr/discover-music/understanding-artist-links/'),
		makeLink('Utiliser les listes d’enregistrements', '/fr/discover-music/using-recording-lists/'),
	]),
	makeGroup('Écouter', [
		makeLink('Utiliser le lecteur', '/fr/listening/using-the-player/'),
		makeLink('File d’attente', '/fr/listening/queue/'),
		makeLink('Favoris', '/fr/listening/favorits/'),
		makeLink('Playlists', '/fr/listening/playlists-en/'),
	]),
	makeGroup('Appareils', [
		makeLink('Navigateur sur ordinateur', '/fr/devices/desktop-browser-en/'),
		makeLink('Problèmes avec les navigateurs mobiles', '/fr/devices/mobile-browser-issues/'),
	]),
	makeGroup('Compte et accès', [
		makeLink('Créer un compte', '/fr/getting-started/create-an-account/'),
		makeLink('Statut de l’abonnement', '/fr/account-access/subscription-status/'),
		makeLink('Mots de passe et accès au compte', '/fr/account-access/passwords-account-access/'),
		makeLink('Utilisation responsable', '/fr/account-access/responsible-use/'),
		makeLink('Se déconnecter', '/fr/account-access/logging-out/'),
	]),
	makeGroup('Dépannage', [
		makeLink('Pas de son', '/fr/troubleshooting/no-sound/'),
		makeLink('La lecture ne démarre pas', '/fr/troubleshooting/playback-does-not-start/'),
		makeLink('La connexion n’est pas mémorisée', '/fr/troubleshooting/login-is-not-remembered/'),
		makeLink('Recharger la page', '/fr/troubleshooting/reloading-the-page/'),
		makeLink('Contacter le support', '/fr/troubleshooting/contact-support/'),
	]),
	makeGroup('FAQ', [makeLink('Questions fréquentes', '/fr/faq-en/')]),
];

const spanishSidebar = [
	makeGroup('Primeros pasos', [
		makeLink('¿Qué es TocaToca?', '/es/getting-started/what-is-tocatoca/'),
		makeLink('Crear una cuenta', '/es/getting-started/create-an-account/'),
		makeLink('Iniciar sesión', '/es/getting-started/logging-in/'),
		makeLink('Activar su suscripción', '/es/getting-started/activate-your-subscription/'),
		makeLink('Primera reproducción', '/es/getting-started/first-playback/'),
	]),
	makeGroup('Descubrir música', [
		makeLink('Usar la búsqueda', '/es/discover-music/using-search/'),
		makeLink('Encontrar artistas', '/es/discover-music/finding-artists/'),
		makeLink('Encontrar álbumes y colecciones', '/es/discover-music/finding-albums-and-collections/'),
		makeLink('Entender los enlaces de artistas', '/es/discover-music/understanding-artist-links/'),
		makeLink('Usar listas de grabaciones', '/es/discover-music/using-recording-lists/'),
	]),
	makeGroup('Escuchar', [
		makeLink('Usar el reproductor', '/es/listening/using-the-player/'),
		makeLink('Cola', '/es/listening/queue/'),
		makeLink('Favoritos', '/es/listening/favorits/'),
		makeLink('Playlists', '/es/listening/playlists-en/'),
	]),
	makeGroup('Dispositivos', [
		makeLink('Navegador de escritorio', '/es/devices/desktop-browser-en/'),
		makeLink('Problemas con navegadores móviles', '/es/devices/mobile-browser-issues/'),
	]),
	makeGroup('Cuenta y acceso', [
		makeLink('Crear una cuenta', '/es/getting-started/create-an-account/'),
		makeLink('Estado de la suscripción', '/es/account-access/subscription-status/'),
		makeLink('Contraseñas y acceso a la cuenta', '/es/account-access/passwords-account-access/'),
		makeLink('Uso responsable', '/es/account-access/responsible-use/'),
		makeLink('Cerrar sesión', '/es/account-access/logging-out/'),
	]),
	makeGroup('Solución de problemas', [
		makeLink('Sin sonido', '/es/troubleshooting/no-sound/'),
		makeLink('La reproducción no empieza', '/es/troubleshooting/playback-does-not-start/'),
		makeLink('El inicio de sesión no se recuerda', '/es/troubleshooting/login-is-not-remembered/'),
		makeLink('Recargar la página', '/es/troubleshooting/reloading-the-page/'),
		makeLink('Contactar con soporte', '/es/troubleshooting/contact-support/'),
	]),
	makeGroup('FAQ', [makeLink('Preguntas frecuentes', '/es/faq-en/')]),
];

const italianSidebar = [
	makeGroup('Primi passi', [
		makeLink('Che cos’è TocaToca?', '/it/getting-started/what-is-tocatoca/'),
		makeLink('Creare un account', '/it/getting-started/create-an-account/'),
		makeLink('Accedere', '/it/getting-started/logging-in/'),
		makeLink('Attivare l’abbonamento', '/it/getting-started/activate-your-subscription/'),
		makeLink('Primo ascolto', '/it/getting-started/first-playback/'),
	]),
	makeGroup('Scoprire musica', [
		makeLink('Usare la ricerca', '/it/discover-music/using-search/'),
		makeLink('Trovare artisti', '/it/discover-music/finding-artists/'),
		makeLink('Trovare album e collezioni', '/it/discover-music/finding-albums-and-collections/'),
		makeLink('Capire i link degli artisti', '/it/discover-music/understanding-artist-links/'),
		makeLink('Usare le liste di registrazioni', '/it/discover-music/using-recording-lists/'),
	]),
	makeGroup('Ascoltare', [
		makeLink('Usare il player', '/it/listening/using-the-player/'),
		makeLink('Coda', '/it/listening/queue/'),
		makeLink('Preferiti', '/it/listening/favorits/'),
		makeLink('Playlist', '/it/listening/playlists-en/'),
	]),
	makeGroup('Dispositivi', [
		makeLink('Browser desktop', '/it/devices/desktop-browser-en/'),
		makeLink('Problemi con i browser mobili', '/it/devices/mobile-browser-issues/'),
	]),
	makeGroup('Account e accesso', [
		makeLink('Creare un account', '/it/getting-started/create-an-account/'),
		makeLink('Stato dell’abbonamento', '/it/account-access/subscription-status/'),
		makeLink('Password e accesso all’account', '/it/account-access/passwords-account-access/'),
		makeLink('Uso responsabile', '/it/account-access/responsible-use/'),
		makeLink('Uscire dall’account', '/it/account-access/logging-out/'),
	]),
	makeGroup('Risoluzione dei problemi', [
		makeLink('Nessun suono', '/it/troubleshooting/no-sound/'),
		makeLink('La riproduzione non parte', '/it/troubleshooting/playback-does-not-start/'),
		makeLink('Il login non viene ricordato', '/it/troubleshooting/login-is-not-remembered/'),
		makeLink('Ricaricare la pagina', '/it/troubleshooting/reloading-the-page/'),
		makeLink('Contattare il supporto', '/it/troubleshooting/contact-support/'),
	]),
	makeGroup('FAQ', [makeLink('Domande frequenti', '/it/faq-en/')]),
];

const sidebar =
	locale === 'en'
		? englishSidebar
		: locale === 'fr'
			? frenchSidebar
			: locale === 'es'
				? spanishSidebar
				: locale === 'it'
					? italianSidebar
					: germanSidebar;
---

<SidebarPersister>
	<SidebarSublist sublist={sidebar} />
</SidebarPersister>

<div class="md:sl-hidden">
	<MobileMenuFooter />
</div>
