---
import { AstroError } from 'astro/errors';
import { Icon } from '@astrojs/starlight/components';
import type { StarlightIcon } from '@astrojs/starlight/types';

const asideVariants = ['note', 'tip', 'caution', 'danger'] as const;
const icons = { note: 'information', tip: 'rocket', caution: 'warning', danger: 'error' } as const;

interface Props {
	type?: (typeof asideVariants)[number];
	title?: string;
	icon?: StarlightIcon;
}

let { type = 'note', title, icon } = Astro.props;

if (!asideVariants.includes(type)) {
	throw new AstroError(
		'Invalid `type` prop passed to the `<Aside>` component.\n',
		`Received: ${JSON.stringify(type)}\n` +
			`Expected one of ${asideVariants.map((i) => JSON.stringify(i)).join(', ')}`
	);
}

if (!title) {
	title = Astro.locals.t(`aside.${type}`);
}

const normalizedTitle = title.toLowerCase();
const callout =
	normalizedTitle.includes('vixelle') || normalizedTitle.includes('tipp')
		? 'vixelle'
		: normalizedTitle.includes('musik') || normalizedTitle.includes('entdeck')
			? 'discovery'
			: normalizedTitle.includes('faq') || normalizedTitle.includes('frage')
				? 'faq'
				: type;

const routeData = Astro.locals.starlightRoute.entry.data;
const showVixelle = routeData.template !== 'splash';
const vixelleImages = {
	vixelle: '/images/brand/Vixelle-info.png',
	discovery: '/images/brand/Vixelle-relaxed.png',
	faq: '/images/brand/Vixelle-thinking.png',
	tip: '/images/brand/Vixelle-info.png',
	note: '/images/brand/Vixelle-info.png',
	caution: '/images/brand/Vixelle-important.png',
	danger: '/images/brand/Vixelle-important.png',
} as const;
const vixelleSrc = vixelleImages[callout as keyof typeof vixelleImages];
---

<aside
	aria-label={title}
	class={`starlight-aside starlight-aside--${type} toc-callout toc-callout--${callout}`}
	data-toca-callout={callout}
>
	<p class="starlight-aside__title" aria-hidden="true">
		<Icon name={icon || icons[type]} class="starlight-aside__icon" />{title}
	</p>
	{showVixelle && vixelleSrc && <img class="toc-callout__vixelle" src={vixelleSrc} alt="" width="96" height="96" loading="lazy" />}
	<div class="starlight-aside__content">
		<slot />
	</div>
</aside>
